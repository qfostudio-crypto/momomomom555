-- ============================================================
--  หาตัวละคร / แยกทีม (สำคัญสำหรับเกมนี้)
--  เกมนี้เก็บตัวละครไว้ที่ Workspace.Characters แยกเป็นโฟลเดอร์ทีม
--    Workspace.Characters.Counter-Terrorists
--    Workspace.Characters.Terrorists
--    Workspace.Characters.Hostages
--  จึงต้องหาโฟลเดอร์และอ่านชื่อทีมจาก "ชื่อโฟลเดอร์แม่" เป็นหลัก
--  เพราะ player.Team ของเกมนี้เชื่อถือไม่ได้เสมอ
-- ============================================================
local CHAR_FOLDER_NAME = "Characters"
local CHAR_MAP_REFRESH = 1.5
local charMap = {}          -- [ชื่อโมเดล] = Model
local charMapAt = 0

local function getCharactersFolder()
    local folder = Workspace:FindFirstChild(CHAR_FOLDER_NAME)
    if folder then return folder end

    -- เผื่อเกมเปลี่ยนชื่อโฟลเดอร์
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Folder") and string.find(string.lower(obj.Name), "character", 1, true) then
            return obj
        end
    end
    return nil
end

local function rebuildCharMap()
    charMap = {}
    local folder = getCharactersFolder()
    if folder then
        for _, obj in ipairs(folder:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                if charMap[obj.Name] == nil then
                    charMap[obj.Name] = obj
                end
            end
        end
    end
    charMapAt = os.clock()
end

-- หาโมเดลตัวละครของผู้เล่น (รองรับทั้ง player.Character และโฟลเดอร์ Characters)
resolveCharacter = function(player)
    if not player then return nil, nil end

    local char = player.Character
    if char and char.Parent then return char, "player.Character" end

    if os.clock() - charMapAt > CHAR_MAP_REFRESH then
        rebuildCharMap()
    end

    local found = charMap[player.Name]
    if found and found.Parent then
        return found, "Characters"
    end
    return nil, nil
end

-- อ่านชื่อทีมจากชื่อโฟลเดอร์แม่ของตัวละคร
local function getCharacterTeamName(char)
    local node = char and char.Parent
    for _ = 1, 4 do
        if not node or node == Workspace then break end
        local lower = string.lower(node.Name)
        if string.find(lower, "counter", 1, true) then return "Counter-Terrorists" end
        if string.find(lower, "terror", 1, true) then return "Terrorists" end
        if string.find(lower, "hostage", 1, true) then return "Hostages" end
        node = node.Parent
    end
    return nil
end

local function isCharAlive(char)
    if not char or not char.Parent then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

local function getAliveChar(player)
    local char = resolveCharacter(player)
    if not isCharAlive(char) then return nil end
    return char
end

-- เทียบว่าอยู่ทีมเดียวกับเราหรือไม่ (อิงโฟลเดอร์ก่อน แล้วค่อยอิง player.Team)
local function isSameTeamAsMe(player)
    local myChar = LocalPlayer.Character
    local myTeam = myChar and getCharacterTeamName(myChar)
    local theirTeam = getCharacterTeamName(getAliveChar(player))

    if myTeam and theirTeam then
        return myTeam == theirTeam
    end

    if player.Team and LocalPlayer.Team then
        return player.Team == LocalPlayer.Team
    end
    return false
end

local function getCamera()
    return Workspace.CurrentCamera
end

-- หาชิ้นส่วนแรกที่เจอจากรายชื่อ
local function firstFound(char, names)
    for _, partName in ipairs(names) do
        local part = char:FindFirstChild(partName)
        if part and part:IsA("BasePart") then return part end
    end
    return nil
end

-- หาชิ้นส่วนที่จะเล็ง (รองรับ R6 / R15 / หุ่นของเกมนี้)
local function resolveAimPart(char, fromPos)
    if not char then return nil end

    local mode = Aimbot.AimPartName

    if mode == "ใกล้สุด" then
        local best, bestDist = nil, math.huge
        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("BasePart") then
                local dist = (obj.Position - fromPos).Magnitude
                if dist < bestDist then bestDist, best = dist, obj end
            end
        end
        return best or firstFound(char, { "HumanoidRootPart", "Head", "Torso" })
    end

    local chain = AIM_PART_CHAINS[mode]
    local part = chain and firstFound(char, chain)
    if part then return part end

    -- fallback สุดท้าย: หาจุดที่พอเล็งได้
    return firstFound(char, { "Head", "HumanoidRootPart", "Torso", "UpperTorso" })
        or char:FindFirstChildWhichIsA("BasePart")
end

local function isTargetAllowed(player)
    if player == LocalPlayer then return false end
    if not player.Parent then return false end
    if not Aimbot.AimAll then
        -- ปิดอยู่ = เล็งเฉพาะศัตรู ไม่รวมพวกทีมเดียวกัน
        if isSameTeamAsMe(player) then return false end
    end
    return true
end

-- เช็คว่ามองเห็นเป้าไหม (ไม่ติดกำแพง)
local function isPartVisible(part, fromPos)
    local dir = part.Position - fromPos
    if dir.Magnitude < 0.1 then return true end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = {}
    local myChar = LocalPlayer.Character
    if myChar then table.insert(ignore, myChar) end
    if part.Parent then table.insert(ignore, part.Parent) end
    params.FilterDescendantsInstances = ignore

    local ok, result = pcall(function() return Workspace:Raycast(fromPos, dir, params) end)
    if not ok then return true end
    return result == nil
end

-- ชดเชยการเคลื่อนที่ของเป้า (ยิ่งปิงสูงยิ่งต้องเผื่อ)
local function getPredictedPos(part)
    local pos = part.Position
    if Aimbot.Prediction > 0 then
        local ping = 0
        pcall(function() ping = LocalPlayer:GetNetworkPing() end)
        local ok, vel = pcall(function() return part.AssemblyLinearVelocity end)
        if ok and vel then
            pos = pos + vel * (ping + Aimbot.Prediction)
        end
    end
    return pos
end

-- รวมเป้าทั้งหมด: ผู้เล่น + (ถ้าเปิด) NPC ในโฟลเดอร์ Characters
local function collectTargets()
    local list = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if isTargetAllowed(player) then
            local char = getAliveChar(player)
            if char then
                list[#list + 1] = { player = player, char = char }
            end
        end
    end

    if Aimbot.AimNPC then
        local folder = getCharactersFolder()
        if folder then
            for _, obj in ipairs(folder:GetDescendants()) do
                if obj:IsA("Model") and obj ~= LocalPlayer.Character
                    and not Players:GetPlayerFromCharacter(obj) and isCharAlive(obj) then
                    -- กันนับซ้ำ: ถ้าชื่อโมเดลตรงกับชื่อผู้เล่นในเกม = เป็นตัวละครผู้เล่น
                    local isPlayerModel = false
                    for _, player in ipairs(Players:GetPlayers()) do
                        if player.Name == obj.Name then
                            isPlayerModel = true
                            break
                        end
                    end
                    if not isPlayerModel then
                        list[#list + 1] = { player = nil, char = obj }
                    end
                end
            end
        end
    end

    return list
end

-- ============================================================
--  เลือกเป้าหมายที่ดีที่สุด
-- ============================================================
local function getBestTarget(fromPos, forward)
    local maxAngle = (Aimbot.FOV >= 360) and 180 or (Aimbot.FOV / 2)
    local best, bestPart, bestScore = nil, nil, math.huge

    -- โหมดเลือกเอง: ถ้ายังไม่เลือกเป้า ก็ไม่ต้องหา
    if Aimbot.TargetMode == "เลือกเอง" and not Aimbot.ManualTarget then
        return nil, nil
    end

    for _, entry in ipairs(collectTargets()) do
        local char = entry.char
        local allowed = true

        if Aimbot.TargetMode == "เลือกเอง" then
            allowed = entry.player ~= nil and entry.player == Aimbot.ManualTarget
        end

        if allowed then
            local part = resolveAimPart(char, fromPos)
            if part then
                local dir = part.Position - fromPos
                local dist = dir.Magnitude
                if dist > 0.1 then
                    local angle = math.deg(math.acos(math.clamp(forward:Dot(dir.Unit), -1, 1)))
                    if angle <= maxAngle then
                        local visible = true
                        if Aimbot.VisibleOnly then
                            visible = isPartVisible(part, fromPos)
                        end
                        if visible then
                            local score
                            if Aimbot.TargetMode == "ใกล้ตัวที่สุด" then
                                score = dist
                            elseif Aimbot.TargetMode == "เลือดน้อยสุด" then
                                local hum = char:FindFirstChildOfClass("Humanoid")
                                score = hum and hum.Health or math.huge
                            else
                                -- ใกล้จุดเล็ง (ค่าเริ่มต้น) / เลือกเอง
                                score = angle
                            end
                            if score < bestScore then
                                bestScore, best, bestPart = score, entry.player, part
                            end
                        end
                    end
                end
            end
        end
    end

    return best, bestPart
end

local function fireTool()
    local char = LocalPlayer.Character
    if not char then return end

    -- Tool:Activate() ใช้ได้ทุกแพลตฟอร์ม จึงเป็นวิธีหลัก
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
        return
    end

    -- ไม่มี Tool: ทำได้แค่บนคอม (มือถือเรียกไม่ได้)
    if Mobile.Enabled then return end

    if type(mouse1click) == "function" then
        pcall(mouse1click)
    else
        pcall(function()
            local virtualUser = game:GetService("VirtualUser")
            virtualUser:CaptureController()
            virtualUser:ClickButton1(Vector2.new())
        end)
    end
end

-- ตรวจว่าผู้เล่นกำลังกดเล็งอยู่ไหม
--  มือถือ = กดปุ่ม AIM ค้างบนจอ | คอม = กดคีย์บาร์ดค้าง
local function isAimHeld()
    if Mobile.Enabled then
        return Mobile.ButtonHeld
    end
    return Aimbot.KeyHeld
end

-- ============================================================
--  ลูป Aimbot (หัวใจของระบบ)
-- ============================================================
local function updateAimbot(dt)
    if not Aimbot.Enabled then return end
    if Aimbot.UseKeybind and not isAimHeld() then
        currentAimTarget = nil
        return
    end

    local cam = getCamera()
    if not cam then return end

    local myChar, myRoot = getRoot()
    if not myChar or not myRoot then return end

    local fromPos, forward

    if Aimbot.ScriptableMode then
        -- โหมดยึดกล้องเอง: วางกล้องที่หัว แล้วหมุนเองทั้งหมด
        -- ใช้เมื่อเกมเขียนทับกล้องไม่ว่าเราจะผูก priority สูงแค่ไหน
        local head = myChar:FindFirstChild("Head") or myChar:FindFirstChild("head")
        fromPos = head and head.Position or (myRoot.Position + Vector3.new(0, 1.5, 0))
        if cam.CameraType ~= Enum.CameraType.Scriptable then
            pcall(function() cam.CameraType = Enum.CameraType.Scriptable end)
        end
        forward = cam.CFrame.LookVector
    else
        -- คงตำแหน่งกล้องเดิมไว้ แก้แค่ทิศทางการหัน (ไม่ให้หลุดมุมมองบุคคลที่ 1)
        fromPos = cam.CFrame.Position
        forward = cam.CFrame.LookVector
    end

    local target, targetPart = getBestTarget(fromPos, forward)
    currentAimTarget = target

    if not targetPart then
        -- ไม่มีเป้า: โหมดยึดกล้องยังต้องตรึงกล้องที่หัว + ให้ผู้เล่นหันเองได้
        if Aimbot.ScriptableMode then
            local dx, dy
            if Mobile.Enabled then
                -- มือถือ: ใช้การลากนิ้วที่สะสมไว้จาก InputChanged
                dx, dy = touchLookX, touchLookY
                touchLookX, touchLookY = 0, 0
            else
                local delta = UserInputService:GetMouseDelta()
                dx, dy = delta.X, delta.Y
            end

            local rot = cam.CFrame - cam.CFrame.Position
            rot = rot * CFrame.Angles(math.rad(-dy * 0.35), math.rad(-dx * 0.35), 0)
            cam.CFrame = CFrame.new(fromPos) * rot
        end
        return
    end

    local dest = getPredictedPos(targetPart)
    if (dest - fromPos).Magnitude < 0.3 then return end

    local desired = CFrame.lookAt(fromPos, dest)

    -- Lerp เฉพาะมุมหัน (ตำแหน่งเท่ากัน จึงเป็นการหมุนล้วน ๆ)
    local alpha = math.clamp(Aimbot.Speed * dt, 0, 1)
    cam.CFrame = cam.CFrame:Lerp(desired, alpha)

    if Aimbot.FaceTarget then
        local flat = Vector3.new(dest.X - myRoot.Position.X, 0, dest.Z - myRoot.Position.Z)
        if flat.Magnitude > 0.3 then
            pcall(function()
                myRoot.CFrame = CFrame.lookAt(myRoot.Position, myRoot.Position + flat)
            end)
        end
    end

    if Aimbot.AutoFire then
        local now = os.clock()
        if now - lastFireAt >= Aimbot.FireDelay then
            lastFireAt = now
            fireTool()
        end
    end
end

local function setAimbotBound(enabled)
    if enabled and not aimBound then
        -- ผูกที่ priority สูงกว่า Enum.RenderPriority.Camera (200)
        -- เพื่อให้รัน "หลัง" สคริปต์กล้องของเกม ค่า CFrame ของเราจึงชนะ
        local priority = Enum.RenderPriority.Camera.Value + AIM_PRIORITY_OFFSET
        local ok = pcall(function()
            RunService:BindToRenderStep(AIM_BIND_NAME, priority, updateAimbot)
        end)
        if ok then
            aimBound = true
        else
            warn("[Coo Hub] ผูก Aimbot เข้ากับ RenderStep ไม่สำเร็จ")
        end
    elseif not enabled and aimBound then
        pcall(function() RunService:UnbindFromRenderStep(AIM_BIND_NAME) end)
        aimBound = false
        currentAimTarget = nil

        -- คืนกล้องให้เกม ถ้าเคยยึดกล้องเอง
        local cam = getCamera()
        if cam and cam.CameraType == Enum.CameraType.Scriptable then
            pcall(function() cam.CameraType = Enum.CameraType.Custom end)
        end
    end
end

-- ============================================================
--  ระบบหาผู้เล่น (ESP)
--  มี 2 โหมด:
--   1) Drawing  — สวยกว่า ใช้ได้บนคอมและมือถือบางตัว
--   2) Highlight — สำรองสำหรับมือถือที่ไม่มี Drawing
-- ============================================================
local function createFinder(player)
    if player == LocalPlayer then return end
    if finderData[player] then return end

    if HAS_DRAWING then
        local box = Drawing.new("Square")
        box.Visible = false
        box.Thickness = 1
        box.Transparency = 1
        box.Filled = false
        box.Color = Color3.fromRGB(255, 60, 60)

        local nameLabel = Drawing.new("Text")
        nameLabel.Visible = false
        nameLabel.Size = 15
        nameLabel.Center = true
        nameLabel.Outline = true
        nameLabel.OutlineColor = Color3.fromRGB(0, 0, 0)
        nameLabel.Font = 3
        nameLabel.Color = Color3.fromRGB(255, 255, 255)

        local distLabel = Drawing.new("Text")
        distLabel.Visible = false
        distLabel.Size = 13
        distLabel.Center = true
        distLabel.Outline = true
        distLabel.OutlineColor = Color3.fromRGB(0, 0, 0)
        distLabel.Font = 3
        distLabel.Color = Color3.fromRGB(255, 255, 0)

        finderData[player] = {
            mode = "drawing",
            box = box,
            nameLabel = nameLabel,
            distLabel = distLabel,
        }
        return
    end

    -- ---- โหมดสำรอง: Highlight + ป้ายชื่อ ----
    local highlight = Instance.new("Highlight")
    highlight.Name = "CooHubESPHighlight"
    highlight.FillTransparency = 0.65
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = false
    highlight.Parent = Workspace

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "CooHubESPTag"
    billboard.Size = UDim2.new(0, 200, 0, 36)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 2.8, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = false

    local label = Instance.new("TextLabel")
    label.Name = "Info"
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.TextScaled = false
    label.TextSize = 14
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Font = Enum.Font.GothamBold
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Parent = billboard

    local ok = pcall(function()
        billboard.Parent = LocalPlayer:WaitForChild("PlayerGui", 10)
    end)
    if not ok or not billboard.Parent then
        pcall(function() highlight:Destroy() end)
        pcall(function() billboard:Destroy() end)
        return
    end

    finderData[player] = {
        mode = "instance",
        highlight = highlight,
        billboard = billboard,
        label = label,
    }
end

local function removeFinder(player)
    local data = finderData[player]
    if not data then return end

    if data.mode == "drawing" then
        for _, key in ipairs({ "box", "nameLabel", "distLabel" }) do
            local obj = data[key]
            if obj then pcall(function() obj:Remove() end) end
        end
    else
        if data.highlight then pcall(function() data.highlight:Destroy() end) end
        if data.billboard then pcall(function() data.billboard:Destroy() end) end
    end

    finderData[player] = nil
end

local function hideFinder(data)
    if data.mode == "drawing" then
        data.box.Visible = false
        data.nameLabel.Visible = false
        data.distLabel.Visible = false
    else
        if data.highlight then data.highlight.Enabled = false end
        if data.billboard then data.billboard.Enabled = false end
    end
end

local function updateFinder()
    local cam = getCamera()
    if not cam then return end
    local _, myRoot = getRoot()
    if not myRoot then return end

    for player, data in pairs(finderData) do
        local char = getAliveChar(player)
        local hrp = char and (char:FindFirstChild("HumanoidRootPart")
            or char:FindFirstChild("Torso")
            or char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Head"))
        local head = char and (char:FindFirstChild("Head")
            or char:FindFirstChild("head")
            or hrp)

        if not (char and hrp and head) then
            hideFinder(data)
            continue
        end

        local dist = (hrp.Position - myRoot.Position).Magnitude
        if Finder.MaxDistance > 0 and dist > Finder.MaxDistance then
            hideFinder(data)
            continue
        end

        -- สี: เป้าที่เล็งอยู่ = เหลือง, ทีมเดียวกัน = เขียว, ศัตรู = แดง
        local color
        if player == currentAimTarget then
            color = Color3.fromRGB(255, 230, 0)
        elseif isSameTeamAsMe(player) then
            color = Color3.fromRGB(70, 235, 90)
        else
            color = Color3.fromRGB(255, 60, 60)
        end

        local suffix = ""
        if Finder.ShowTeam then
            local teamName = getCharacterTeamName(char) or (player.Team and player.Team.Name)
            suffix = teamName and (" [" .. teamName .. "]") or ""
        end
        local title = player.Name .. suffix

        -- ---- โหมดสำรอง (มือถือที่ไม่มี Drawing) ----
        if data.mode == "instance" then
            data.highlight.Adornee = char
            data.highlight.FillColor = color
            data.highlight.OutlineColor = color
            data.highlight.Enabled = Finder.ShowBox

            data.billboard.Adornee = head
            data.label.Text = title .. (Finder.ShowDistance and string.format("  %.0f studs", dist) or "")
            data.label.TextColor3 = color
            data.billboard.Enabled = true
            continue
        end

        -- ---- โหมด Drawing ----
        local rootScreen, onScreen = cam:WorldToViewportPoint(hrp.Position)
        if not onScreen then
            hideFinder(data)
            continue
        end

        local headScreen = cam:WorldToViewportPoint(head.Position)

        local height = math.max(math.abs(headScreen.Y - rootScreen.Y) * 1.6, 24)
        local width = height * 0.5
        local boxPos = Vector2.new(rootScreen.X - width / 2, rootScreen.Y - height / 2)

        data.box.Size = Vector2.new(width, height)
        data.box.Position = boxPos
        data.box.Color = color
        data.box.Visible = Finder.ShowBox

        data.nameLabel.Text = title
        data.nameLabel.Color = color
        data.nameLabel.Position = Vector2.new(rootScreen.X, boxPos.Y - 18)
        data.nameLabel.Visible = true

        data.distLabel.Text = string.format("%.0f studs", dist)
        data.distLabel.Position = Vector2.new(rootScreen.X, boxPos.Y + height + 2)
        data.distLabel.Visible = Finder.ShowDistance
    end
end

local function setFinderBound(enabled)
    if enabled and not finderBound then
        for _, player in ipairs(Players:GetPlayers()) do
            createFinder(player)
        end
        local ok = pcall(function()
            RunService:BindToRenderStep(FIND_BIND_NAME, Enum.RenderPriority.Character.Value + 1, updateFinder)
        end)
        if ok then
            finderBound = true
        else
            for player in pairs(finderData) do removeFinder(player) end
        end
    elseif not enabled and finderBound then
        pcall(function() RunService:UnbindFromRenderStep(FIND_BIND_NAME) end)
        finderBound = false
        for player in pairs(finderData) do
            removeFinder(player)
        end
        table.clear(finderData)
    end
end

