   Content = "ปิดระบบบินก่อนรีเซ็ตตัวละครเพื่อให้ควบคุมได้ปกติ",
})

-- ============================================================
--  ระบบ Unload: ปลด connection + ปิด UI ให้สะอาด
-- ============================================================
getgenv().CooHubUnload = function()
    stopFly()

    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(connections)

    pcall(function() Rayfield:Destroy() end)

    getgenv().CooHubLoaded = false
    getgenv().CooHubUnload = nil
    print("[Coo Hub] Unloaded")
end
