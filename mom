-- ============================================================
--  ระบบบิน
-- ============================================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local flyEnabled = false
local flySpeed = 60
local flyVelocity
local flyGyro
local flyHumanoid
local flyRoot
local flyUpHeld = false
local flyDownHeld = false
local flyControlsBound = false

local function handleFlyUp(_, inputState)
    flyUpHeld = inputState == Enum.UserInputState.Begin
    return Enum.ContextActionResult.Sink
end

local function handleFlyDown(_, inputState)
    flyDownHeld = inputState == Enum.UserInputState.Begin
    return Enum.ContextActionResult.Sink
end

local function bindFlyControls()
    if flyControlsBound then
        return
    end

    flyControlsBound = true
    ContextActionService:BindAction(
        "CooHubFlyUp",
        handleFlyUp,
        UserInputService.TouchEnabled,
        Enum.KeyCode.Space
    )
    ContextActionService:BindAction(
        "CooHubFlyDown",
        handleFlyDown,
        UserInputService.TouchEnabled,
        Enum.KeyCode.LeftControl
    )

    if UserInputService.TouchEnabled then
        ContextActionService:SetTitle("CooHubFlyUp", "ขึ้น")
        ContextActionService:SetTitle("CooHubFlyDown", "ลง")
        ContextActionService:SetPosition("CooHubFlyUp", UDim2.new(1, -155, 1, -265))
        ContextActionService:SetPosition("CooHubFlyDown", UDim2.new(1, -80, 1, -340))
    end
end

local function unbindFlyControls()
    ContextActionService:UnbindAction("CooHubFlyUp")
    ContextActionService:UnbindAction("CooHubFlyDown")
    flyControlsBound = false
    flyUpHeld = false
    flyDownHeld = false
end

local function stopFly()
    flyEnabled = false
    unbindFlyControls()

    if flyVelocity then
        flyVelocity:Destroy()
        flyVelocity = nil
    end

    if flyGyro then
        flyGyro:Destroy()
        flyGyro = nil
    end

    if flyHumanoid and flyHumanoid.Parent then
        flyHumanoid.PlatformStand = false
        flyHumanoid.AutoRotate = true
    end

    if flyRoot and flyRoot.Parent then
        flyRoot.AssemblyLinearVelocity = Vector3.zero
        flyRoot.AssemblyAngularVelocity = Vector3.zero
    end

    flyHumanoid = nil
    flyRoot = nil
end

local function startFly()
    stopFly()

    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or humanoid.Health <= 0 then
        warn("[Coo Hub] ไม่พบตัวละครสำหรับเริ่มบิน")
        return false
    end

    flyHumanoid = humanoid
    flyRoot = root
    flyEnabled = true

    humanoid.PlatformStand = true
    humanoid.AutoRotate = false

    flyVelocity = Instance.new("BodyVelocity")
    flyVelocity.Name = "CooHubFlyVelocity"
    flyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    flyVelocity.P = 12500
    flyVelocity.Velocity = Vector3.zero
    flyVelocity.Parent = root

    flyGyro = Instance.new("BodyGyro")
    flyGyro.Name = "CooHubFlyGyro"
    flyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    flyGyro.P = 12500
    flyGyro.D = 500
    flyGyro.CFrame = root.CFrame
    flyGyro.Parent = root

    bindFlyControls()

    return true
end

addConnection(RunService.RenderStepped:Connect(function()
    if not flyEnabled then
        return
    end

    if not flyRoot or not flyRoot.Parent or not flyHumanoid or flyHumanoid.Health <= 0 then
        stopFly()
        return
    end

    local camera = workspace.CurrentCamera
    if not camera or not flyVelocity or not flyGyro then
        return
    end

    local input = Vector3.zero
    if UserInputService.TouchEnabled then
        -- จอยเดินมาตรฐานของ Roblox ส่งทิศทางมาใน MoveDirection อยู่แล้ว
        local moveDirection = flyHumanoid.MoveDirection
        input += Vector3.new(moveDirection.X, 0, moveDirection.Z)
    else
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then input += camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then input -= camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then input += camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then input -= camera.CFrame.RightVector end
    end

    if flyUpHeld then input += Vector3.yAxis end
    if flyDownHeld then input -= Vector3.yAxis end

    flyHumanoid.PlatformStand = true
    flyVelocity.Velocity = input.Magnitude > 0 and input.Unit * flySpeed or Vector3.zero
    flyGyro.CFrame = CFrame.lookAt(flyRoot.Position, flyRoot.Position + camera.CFrame.LookVector)
end))

addConnection(LocalPlayer.CharacterAdded:Connect(function()
    stopFly()
end))

-- ============================================================
--  ตัวค้นหาของดี/ไข่ดีสำหรับแอดมิน
--  ใส่ Tag "GoodItem" หรือ "GoodEgg" ให้ Model/Part ใน Roblox Studio
--  นอก Studio ต้องให้ Server ตั้ง Attribute CooHubAdmin = true ที่ Player
-- ============================================================
local finderStates = {
    GoodItem = false,
    GoodEgg = false,
}
local finderMarkers = {
    GoodItem = {},
    GoodEgg = {},
}
local finderColors = {
    GoodItem = Color3.fromRGB(255, 205, 45),
    GoodEgg = Color3.fromRGB(120, 220, 255),
}
local finderLabels = {
    GoodItem = "ของดี",
    GoodEgg = "ไข่ดี",
}
local finderElapsed = 0

local function canUseAdminFinder()
    return RunService:IsStudio()
        or (game.CreatorType == Enum.CreatorType.User and LocalPlayer.UserId == game.CreatorId)
        or LocalPlayer:GetAttribute("CooHubAdmin") == true
end

local function getFinderPart(instance)
    if instance:IsA("BasePart") then
        return instance
    end
    if instance:IsA("Model") then
        return instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart", true)
    end
    return instance:FindFirstChildWhichIsA("BasePart", true)
end

local function removeFinderMarker(tagName, instance)
    local marker = finderMarkers[tagName][instance]
    if not marker then
        return
    end

    if marker.highlight then marker.highlight:Destroy() end
    if marker.billboard then marker.billboard:Destroy() end
    finderMarkers[tagName][instance] = nil
end

local function clearFinderMarkers(tagName)
    for instance in pairs(finderMarkers[tagName]) do
        removeFinderMarker(tagName, instance)
    end
end

local function addFinderMarker(tagName, instance)
    if finderMarkers[tagName][instance] or not instance:IsDescendantOf(workspace) then
        return
    end

    local part = getFinderPart(instance)
    if not part then
        return
    end

    local color = finderColors[tagName]
    local highlight = Instance.new("Highlight")
    highlight.Name = "CooHub" .. tagName .. "Highlight"
    highlight.Adornee = (instance:IsA("Model") or instance:IsA("BasePart")) and instance or part
    highlight.FillColor = color
    highlight.FillTransparency = 0.55
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = instance

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "CooHub" .. tagName .. "Label"
    billboard.Adornee = part
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 2500
    billboard.Size = UDim2.fromOffset(190, 42)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
    billboard.Parent = LocalPlayer:WaitForChild("PlayerGui")

    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
    label.BackgroundTransparency = 0.2
    label.BorderSizePixel = 0
    label.Size = UDim2.fromScale(1, 1)
    label.Font = Enum.Font.GothamBold
    label.TextColor3 = color
    label.TextScaled = true
    label.TextStrokeTransparency = 0.45
    label.Parent = billboard

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = label

    finderMarkers[tagName][instance] = {
        highlight = highlight,
        billboard = billboard,
        label = label,
        part = part,
    }
end

local function refreshFinder(tagName)
    if not finderStates[tagName] then
        clearFinderMarkers(tagName)
        return
    end

    if not canUseAdminFinder() then
        finderStates[tagName] = false
        clearFinderMarkers(tagName)
        warn("[Coo Hub] ไม่มีสิทธิ์ใช้ตัวค้นหาแอดมิน")
        return
    end

    local taggedNow = {}
    for _, instance in ipairs(CollectionService:GetTagged(tagName)) do
        if instance:IsDescendantOf(workspace) then
            taggedNow[instance] = true
            addFinderMarker(tagName, instance)
        end
    end

    for instance in pairs(finderMarkers[tagName]) do
        if not taggedNow[instance] or not instance.Parent then
            removeFinderMarker(tagName, instance)
        end
    end
end

local function updateFinderDistances()
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then
        return
    end

    for tagName, markers in pairs(finderMarkers) do
        for instance, marker in pairs(markers) do
            if not instance.Parent or not marker.part or not marker.part.Parent then
                removeFinderMarker(tagName, instance)
            else
                local distance = (root.Position - marker.part.Position).Magnitude
                marker.label.Text = string.format("%s: %s  •  %.0f เมตร", finderLabels[tagName], instance.Name, distance)
            end
        end
    end
end

addConnection(RunService.Heartbeat:Connect(function(deltaTime)
    finderElapsed += deltaTime
    if finderElapsed < 0.35 then
        return
    end
    finderElapsed = 0

    refreshFinder("GoodItem")
    refreshFinder("GoodEgg")
    updateFinderDistances()
end))

