-- ---- Loop ----
addConnection(RunService.Heartbeat:Connect(function()
    local now = os.clock()

    if AutoHuntEnabled then
        if now - HuntLastAction >= HuntDelay then
            HuntLastAction = now
            pruneVisited()
            huntStep()
        end
    end

    if ArtifactHighlightEnabled and now - HighlightLastRefresh > 2 then
        if now - artifactCacheAt > ARTIFACT_REFRESH then
            collectArtifacts()
        end
        refreshArtifactHighlights()
    end
end))

-- ============================================================
--  ระบบ Unload: ปลด connection ทั้งหมด + ปิด UI ให้สะอาด
-- ============================================================
getgenv().CooHubUnload = function()
    if ESPEnabled then
        toggleESP(false)
    end

    -- หยุดระบบฟาร์มขุด + Anti-AFK
    AutoDigEnabled = false
    setAntiAFK(false)
    table.clear(digTargets)

    -- หยุดระบบวาปหาของหายาก + ลบไฮไลต์
    AutoHuntEnabled = false
    ArtifactHighlightEnabled = false
    clearArtifactHighlights()
    table.clear(artifactCache)
    table.clear(visitedArtifacts)
    lastHuntTarget = nil

    for player in pairs(ESPData) do
        removeESP(player)
    end

    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(connections)

    pcall(function() Rayfield:Destroy() end)

    getgenv().CooHubLoaded = false
    getgenv().CooHubUnload = nil
    print("[Coo Hub] Unloaded")
end
