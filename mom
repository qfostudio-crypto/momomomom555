addConnection(RunService.Heartbeat:Connect(function()
    if not AutoDigEnabled then return end
    local now = os.clock()
    if now - AutoDigLastFire < AutoDigDelay then return end
    AutoDigLastFire = now
    fireDig()
end))

-- ============================================================
--  ระบบวาปหาของหายาก (Artifact Hunter)
--  ขั้นตอน: สแกนหาของหายาก -> วาปไป -> ขุด -> กดเก็บ (ArtifactPickup)
--  อ้างอิง remote ที่ดักได้จาก Cobalt:
--    ReplicatedStorage.ArtifactPickup  (argument มีชื่อของ เช่น "Phoenix Feather")
--    ReplicatedStorage.Dig:FireServer(Vector3 ตำแหน่ง, Vector3 ทิศทาง, nil)
--  *** ชื่อ/ระดับความหายากตรวจจับจาก attribute หรือชื่อชิ้นส่วน
--      ถ้าเกมเก็บข้อมูลไว้ที่อื่น ให้เพิ่มชื่อของในช่อง "ชื่อของเพิ่มเติม" ***
-- ============================================================

-- ---- State ----
local AutoHuntEnabled = false
local TeleportToArtifact = true
local DigAfterTeleport = true
local PickupAfterTeleport = true
local ArtifactHighlightEnabled = false
local HuntLogEnabled = false
local ArtifactRarityFilter = { "Rare", "Epic", "Legendary", "Mythic", "Secret", "Unknown" }
local HuntDelay = 0.5
local HuntLastAction = 0
local HighlightLastRefresh = 0
local PickupCallStyle = "ตำแหน่ง + ชื่อ"
local HuntExtraNames = {}
local artifactCache = {}
local artifactCacheAt = 0
local artifactHighlights = {}
local visitedArtifacts = {}          -- [part] = os.clock() เวลาที่เพิ่งเก็บไป
local lastHuntTarget = nil

local ARTIFACT_REFRESH = 1.5          -- วินาที ก่อนสแกนของใหม่
local HUNT_VISIT_COOLDOWN = 6         -- วินาที กันยิงซ้ำชิ้นเดิมรัว ๆ
local HUNT_MAX_SCAN = 200             -- จำนวนชิ้นสูงสุดต่อการสแกน (กันหน่วง)

-- ---- ระดับความหายาก ----
local RARITY_ORDER = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret", "Unknown" }

-- เรียงจากเฉพาะเจาะจง -> กว้าง (สำคัญ: "uncommon" ต้องเช็คก่อน "common")
local RARITY_MATCH_ORDER = { "Secret", "Mythic", "Legendary", "Epic", "Uncommon", "Rare", "Common" }
local RARITY_KEYWORDS = {
    Common    = { "common", "ธรรมดา" },
    Uncommon  = { "uncommon", "ไม่ธรรมดา" },
    Rare      = { "rare", "หายาก" },
    Epic      = { "epic", "มหากาพย์" },
    Legendary = { "legendary", "legacy", "ตำนาน" },
    Mythic    = { "mythic", "myth", "เทพ" },
    Secret    = { "secret", "exotic", "godly", "ลับ" },
}
local RARITY_COLORS = {
    Common    = Color3.fromRGB(185, 185, 185),
    Uncommon  = Color3.fromRGB(80, 220, 100),
    Rare      = Color3.fromRGB(70, 140, 255),
    Epic      = Color3.fromRGB(170, 80, 255),
    Legendary = Color3.fromRGB(255, 180, 40),
    Mythic    = Color3.fromRGB(255, 70, 70),
    Secret    = Color3.fromRGB(0, 255, 230),
    Unknown   = Color3.fromRGB(255, 255, 255),
}

local function normalizeRarity(text)
    if text == nil then return "Unknown" end
    local s = tostring(text)

    -- กรณีเก็บเป็นตัวเลขระดับ (1 = ธรรมดา, 8 = ลับสุด)
    local num = tonumber(s)
    if num then
        local index = math.clamp(math.floor(num), 1, #RARITY_ORDER)
        return RARITY_ORDER[index]
    end

    local lower = string.lower(s)
    for _, rarity in ipairs(RARITY_MATCH_ORDER) do
        for _, keyword in ipairs(RARITY_KEYWORDS[rarity]) do
            if string.find(lower, keyword, 1, true) then
                return rarity
            end
        end
    end
    return "Unknown"
end

local RARITY_ATTRIBUTES = { "Rarity", "RarityName", "RarityTier", "Tier", "Quality", "Grade", "TierName" }
local function getArtifactRarity(part)
    for _, attr in ipairs(RARITY_ATTRIBUTES) do
        local ok, value = pcall(function() return part:GetAttribute(attr) end)
        if ok and value ~= nil then
            return normalizeRarity(value)
        end
    end
    return normalizeRarity(part.Name)
end

local function rarityAllowed(rarity)
    for _, allowed in ipairs(ArtifactRarityFilter) do
        if allowed == rarity then return true end
    end
    return false
end

-- ---- ตรวจจับว่าชิ้นส่วนนี้ "ของหายาก" ไหม ----
local function isArtifact(part)
    if not part:IsA("BasePart") then return false end

    -- 1) attribute บอกตรง ๆ
    local ok, flag = pcall(function()
        return part:GetAttribute("Artifact") or part:GetAttribute("IsArtifact")
    end)
    if ok and flag then return true end

    local lower = string.lower(part.Name)

    -- 2) ชื่อมีคำว่า artifact
    if string.find(lower, "artifact", 1, true) then return true end

    -- 3) ชื่อของที่รู้จัก (จาก Cobalt: "Phoenix Feather")
    if string.find(lower, "phoenix", 1, true) then return true end

    -- 4) ชื่อที่ผู้ใช้เพิ่มเอง
    for _, name in ipairs(HuntExtraNames) do
        if string.find(lower, name, 1, true) then return true end
    end

    -- 5) อยู่ในโฟลเดอร์ที่ชื่อมีคำว่า artifact
    local parent = part.Parent
    for _ = 1, 3 do
        if not parent then break end
        if string.find(string.lower(parent.Name), "artifact", 1, true) then
            return true
        end
        parent = parent.Parent
    end

    return false
end

-- ---- สแกนหาของหายาก ----
local function collectArtifacts()
    artifactCache = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isArtifact(obj) then
            table.insert(artifactCache, obj)
            if #artifactCache >= HUNT_MAX_SCAN then break end
        end
    end
    artifactCacheAt = os.clock()
end

local function pruneVisited()
    local alive = 0
    for part in pairs(visitedArtifacts) do
        if part.Parent then
            alive += 1
        else
            visitedArtifacts[part] = nil
        end
    end
    if alive > 250 then
        table.clear(visitedArtifacts)
    end
end

local function getNearestArtifact(origin)
    if os.clock() - artifactCacheAt > ARTIFACT_REFRESH then
        collectArtifacts()
    end

    local best, bestDist, bestRarity = nil, math.huge, nil
    local now = os.clock()
    for _, part in ipairs(artifactCache) do
        if part.Parent then
            local seenAt = visitedArtifacts[part]
            if not seenAt or now - seenAt > HUNT_VISIT_COOLDOWN then
                local rarity = getArtifactRarity(part)
                if rarityAllowed(rarity) then
                    local dist = (part.Position - origin).Magnitude
                    if dist < bestDist then
                        bestDist, best, bestRarity = dist, part, rarity
                    end
                end
            end
        end
    end
    return best, bestRarity, bestDist
end

-- ---- Remote ของ ArtifactPickup ----
local function getPickupRemote()
    local replicated = game:GetService("ReplicatedStorage")
    local remote = replicated:FindFirstChild("ArtifactPickup")
    if remote and remote:IsA("RemoteEvent") then return remote end

    for _, obj in ipairs(replicated:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local name = string.lower(obj.Name)
            if string.find(name, "artifact", 1, true) or string.find(name, "pickup", 1, true) then
                return obj
            end
        end
    end
    return nil
end

local function firePickup(part)
    local remote = getPickupRemote()
    if not remote then return end

    if PickupCallStyle == "ตำแหน่ง" then
        pcall(function() remote:FireServer(part.Position) end)
    elseif PickupCallStyle == "ชื่อ" then
        pcall(function() remote:FireServer(part.Name) end)
    elseif PickupCallStyle == "ชิ้นส่วน" then
        pcall(function() remote:FireServer(part) end)
    else -- ตำแหน่ง + ชื่อ
        pcall(function() remote:FireServer(part.Position, part.Name) end)
    end
end

-- ---- วาป + ขุดตรงตำแหน่งที่กำหนด ----
local function teleportTo(position)
    local char, rootPart = getRoot()
    if not char or not rootPart then return false end
    local ok = pcall(function()
        rootPart.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
    end)
    return ok
end

local function fireDigAtPos(targetPos)
    local char, rootPart = getRoot()
    if not char or not rootPart then return end

    local remote = getDigRemote()
    if not remote then return end

    local delta = targetPos - rootPart.Position
    delta = Vector3.new(delta.X, 0, delta.Z)              -- ตัดแกน Y กันทิศทางเอียง
    local direction = delta.Magnitude > 0.1 and delta.Unit or Vector3.new(1, 0, 0)

    pcall(function() remote:FireServer(targetPos, direction, nil) end)
end

-- ---- ไฮไลต์ของหายาก ----
local function clearArtifactHighlights()
    for part, adorn in pairs(artifactHighlights) do
        pcall(function() adorn:Destroy() end)
    end
    table.clear(artifactHighlights)
end

local function refreshArtifactHighlights()
    clearArtifactHighlights()
    if not ArtifactHighlightEnabled then return end

    for _, part in ipairs(artifactCache) do
        if part.Parent then
            local adorn = Instance.new("BoxHandleAdornment")
            adorn.Name = "CooHubArtifactAdorn"
            adorn.Adornee = part
            adorn.AlwaysOnTop = true
            adorn.ZIndex = 5
            adorn.Transparency = 0.6
            adorn.Color3 = RARITY_COLORS[getArtifactRarity(part)] or RARITY_COLORS.Unknown
            adorn.Size = part.Size
            adorn.Parent = part
            artifactHighlights[part] = adorn
        end
    end
    HighlightLastRefresh = os.clock()
end

-- ---- ขั้นตอนหลัก: วาป -> ขุด -> เก็บ ----
local function huntStep()
    local char, rootPart = getRoot()
    if not char or not rootPart then return end

    local target, rarity, dist = getNearestArtifact(rootPart.Position)
    if not target then return end

    visitedArtifacts[target] = os.clock()      -- ทำเครื่องหมายกันยิงซ้ำ
    lastHuntTarget = target

    if TeleportToArtifact then
        teleportTo(target.Position)
    end

    if DigAfterTeleport then
        fireDigAtPos(target.Position)
    end

    if PickupAfterTeleport then
        firePickup(target)
    end

    if HuntLogEnabled then
        print(string.format("[Coo Hub] เจอ %s | ระดับ %s | ห่าง %.0f studs",
            target.Name, tostring(rarity), dist or 0))
    end
end

