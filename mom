local function runDiagnostics()
    local function log(text)
        print("[Coo Hub] " .. text)
    end

    log("========== COO HUB DIAGNOSTICS ==========")

    local cam = getCamera()
    log("Camera: " .. (cam and cam.Name or "ไม่พบ"))
    log("CameraType: " .. (cam and tostring(cam.CameraType) or "-"))
    log("Priority ที่ผูกไว้: " .. tostring(Enum.RenderPriority.Camera.Value + AIM_PRIORITY_OFFSET))
    log("Aimbot ผูกอยู่: " .. tostring(aimBound) .. " | Finder ผูกอยู่: " .. tostring(finderBound))

    local myChar = resolveCharacter(LocalPlayer)
    log("ตัวละครตัวเอง: " .. (myChar and myChar:GetFullName() or "ไม่พบ (สำคัญ!)"))
    log("ทีมตัวเอง: " .. tostring((myChar and getCharacterTeamName(myChar))
        or (LocalPlayer.Team and LocalPlayer.Team.Name) or "-"))

    local folder = getCharactersFolder()
    log("โฟลเดอร์ Characters: " .. (folder and folder:GetFullName() or "ไม่พบ"))

    if folder then
        local count = 0
        for _, obj in ipairs(folder:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                count = count + 1
            end
        end
        log("จำนวนตัวละครในโฟลเดอร์: " .. tostring(count))
    end

    local fromPos = cam and cam.CFrame.Position or Vector3.zero
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = resolveCharacter(player)
            local part = char and resolveAimPart(char, fromPos)
            log(string.format("%s | ตัวละคร: %s | ทีม: %s | จุดเล็ง: %s | ระยะ: %.0f studs",
                player.Name,
                char and "เจอ" or "ไม่เจอ",
                tostring((char and getCharacterTeamName(char)) or (player.Team and player.Team.Name) or "-"),
                part and part.Name or "-",
                part and (part.Position - fromPos).Magnitude or 0))
        end
    end

    log("=========================================")

    Rayfield:Notify({
        Title = "Coo Hub - วินิจฉัยระบบ",
        Content = string.format("ตัวละครตัวเอง: %s\nโฟลเดอร์ Characters: %s\n(ดูรายละเอียดเต็มใน Console F9)",
            myChar and "เจอ" or "ไม่เจอ",
            folder and "เจอ" or "ไม่เจอ"),
        Duration = 8,
    })
end

