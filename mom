   Callback = function()
      local target = Aimbot.ManualTarget or currentAimTarget
      if not target then
         Rayfield:Notify({
            Title = "Coo Hub",
            Content = "ยังไม่ได้เลือกเป้าหมาย (เลือกช่อง 'เลือกเป้าหมายเอง' ก่อน)",
            Duration = 4,
         })
         return
      end
      local _, myRoot = getRoot()
      local tChar = resolveCharacter(target)
      local tRoot = tChar and (tChar:FindFirstChild("HumanoidRootPart")
          or tChar:FindFirstChild("Torso")
          or tChar:FindFirstChild("UpperTorso"))
      if not myRoot or not tRoot then
         Rayfield:Notify({ Title = "Coo Hub", Content = "หาตัวเป้าหมายไม่เจอ", Duration = 3 })
         return
      end
      pcall(function()
         myRoot.CFrame = CFrame.new(tRoot.Position + Vector3.new(0, 3, 0))
      end)
      Rayfield:Notify({
         Title = "Coo Hub",
         Content = "วาปไปหา " .. target.Name .. " แล้ว",
         Duration = 3,
      })
   end,
})

