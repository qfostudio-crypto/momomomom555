})

-- ============================================================
--  ระบบ Unload: ปลด connection + ปิด UI ให้สะอาด
-- ============================================================
getgenv().CooHubUnload = function()
    -- หยุดระบบทั้งหมดก่อน
    Aimbot.Enabled = false
    setAimbotBound(false)

    Finder.Enabled = false
    setFinderBound(false)
    table.clear(finderData)

    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(connections)

    pcall(function() Rayfield:Destroy() end)

    getgenv().CooHubLoaded = false
    getgenv().CooHubUnload = nil
    print("[Coo Hub] Unloaded")
end
