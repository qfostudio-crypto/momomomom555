   Increment = 5,
   Suffix = " Speed",
   CurrentValue = flySpeed,
   Flag = "CooHubFlySpeed",
   Callback = function(value)
      flySpeed = value
   end,
})

MainTab:CreateSection("ข้อมูล")

MainTab:CreateParagraph({
   Title = "เวอร์ชัน",
   Content = "Coo Hub V2.1 (Admin Fly)",
})

MainTab:CreateSection("ประกาศ")

MainTab:CreateParagraph({
