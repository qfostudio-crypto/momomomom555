local function getRoot()
    local char = LocalPlayer.Character
    if not char then return nil, nil end
    return char, char:FindFirstChild("HumanoidRootPart")
end

local function updateSpeed()
    if not SpeedEnabled then return end
    local char, rootPart = getRoot()
    if not char or not rootPart then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    if IsFrozen and FrozenPosition then
        rootPart.CFrame = FrozenPosition
        return
    end

    -- วิ่ง: ใช้ WalkSpeed (เสถียรและไม่ชนฟิสิกส์ของเกม)
    humanoid.WalkSpeed = SpeedValue
end

-- บินแนวตั้ง: ใช้ deltaTime จาก Heartbeat โดยตรง (ไม่ yield ซ้อนในลูป)
local function updateFly(dt)
    if not SpeedEnabled or not IsFlying or IsFrozen or VerticalSpeed == 0 then return end
    local char, rootPart = getRoot()
    if not char or not rootPart then return end
    rootPart.CFrame = rootPart.CFrame + Vector3.new(0, VerticalSpeed * dt, 0)
end

local function isEnemy(player)
    if player == LocalPlayer then return false end
    if not KillAuraTeamCheck then return true end
    if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return false
    end
    return true
end

local function getNearestEnemy(range)
    local _, rootPart = getRoot()
    if not rootPart then return nil end

    local closestPlayer, closestDistance = nil, range
    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            local char = player.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local dist = (hrp.Position - rootPart.Position).Magnitude
                    if dist < closestDistance then
                        closestDistance = dist
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

local function updateKillAura()
    local char, rootPart = getRoot()
    if not char or not rootPart then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local target = getNearestEnemy(KillAuraRange)
    if not target or not target.Character then return end
    local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end

    local myPos = rootPart.Position

    if KillAuraTeleport then
        local dest = targetRoot.Position + Vector3.new(0, 2, 0)
        pcall(function() rootPart.CFrame = CFrame.new(dest) end)
        myPos = dest
    end

    -- หันหน้าเข้าหาศัตรู (กันเวกเตอร์ยาว 0 ทำให้ CFrame กลายเป็น NaN)
    local flatDir = Vector3.new(targetRoot.Position.X - myPos.X, 0, targetRoot.Position.Z - myPos.Z)
    if flatDir.Magnitude > 0.1 then
        pcall(function()
            rootPart.CFrame = CFrame.new(rootPart.Position, rootPart.Position + flatDir)
        end)
    end

    -- หา Tool: ถ้าถืออยู่ใช้เลย ไม่งั้นหยิบจาก Backpack
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then
        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        if backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                if item:IsA("Tool") then
                    pcall(function() humanoid:EquipTool(item) end)
                    tool = item
                    break
                end
            end
        end
    end

    if tool and tool:IsA("Tool") then
        pcall(function() tool:Activate() end)
    else
        humanoid:MoveTo(targetRoot.Position)
    end
end

addConnection(UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not SpeedEnabled or gameProcessed then return end
    local char, rootPart = getRoot()
    if not char or not rootPart then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")

    if input.KeyCode == Enum.KeyCode.Space then
        if not IsFrozen then
            VerticalSpeed = SpeedValue
            IsFlying = true
        end
    elseif input.KeyCode == Enum.KeyCode.LeftControl then
        if not IsFrozen then
            VerticalSpeed = -SpeedValue
            IsFlying = true
        end
    elseif input.KeyCode == Enum.KeyCode.T then
        IsFrozen = not IsFrozen
        if humanoid then
            if IsFrozen then
                FrozenPosition = rootPart.CFrame
                humanoid.WalkSpeed = 0
                VerticalSpeed = 0
                IsFlying = false
            else
                FrozenPosition = nil
                humanoid.WalkSpeed = SpeedValue
            end
        end
    end
end))

addConnection(UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.LeftControl then
