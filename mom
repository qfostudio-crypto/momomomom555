      if not hum then
         Rayfield:Notify({ Title = "Coo Hub", Content = "หาตัวละครไม่เจอ", Duration = 3 })
         return
      end
      local spawn = Workspace:FindFirstChildOfClass("SpawnLocation")
      if not spawn then
         Rayfield:Notify({ Title = "Coo Hub", Content = "หา SpawnLocation ไม่เจอ", Duration = 3 })
         return
      end
      pcall(function() hum:MoveTo(spawn.Position + Vector3.new(0, 5, 0)) end)
      Rayfield:Notify({ Title = "Coo Hub", Content = "กลับจุดเริ่มต้นแล้ว", Duration = 3 })
   end,
})

-- ============================================================
--  ระบบ Unload: ปลด connection + ปิด UI ให้สะอาด
-- ============================================================
getgenv().CooHubUnload = function()
    -- หยุดระบบทั้งหมดก่อน
    Aimbot.Enabled = false
    setAimbotBound(false)

    -- คืนกล้องให้เกม (กรณีเปิดโหมดยึดกล้องเองไว้)
    local cam = getCamera()
    if cam and cam.CameraType == Enum.CameraType.Scriptable then
        pcall(function() cam.CameraType = Enum.CameraType.Custom end)
    end

    Finder.Enabled = false
    setFinderBound(false)
    table.clear(finderData)

    -- ลบปุ่ม AIM บนจอ (สำคัญสำหรับมือถือ)
    setMobileButtonHeld(false)
    if Mobile.Gui then
        pcall(function() Mobile.Gui:Destroy() end)
        Mobile.Gui = nil
        Mobile.Button = nil
    end

    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(connections)

    pcall(function() Rayfield:Destroy() end)

    getgenv().CooHubLoaded = false
    getgenv().CooHubUnload = nil
    print("[Coo Hub] Unloaded")
end
