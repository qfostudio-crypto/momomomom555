-- ============================================================
--  ระบบ Auto Dig (ฟาร์มขุดอัตโนมัติ)
--  อ้างอิงจาก remote ที่ดักได้จาก Cobalt:
--    ReplicatedStorage.Dig:FireServer(Vector3 ตำแหน่ง, Vector3 ทิศทาง, nil)
--  หมายเหตุ: argument ของแต่ละเกมอาจไม่เหมือนกัน ให้ปรับผ่านเมนูได้
-- ============================================================

-- ---- State ----
local AutoDigEnabled = false
local AutoDigDelay = 0.2
local AutoDigLastFire = 0
local AutoDigSendTool = false          -- ส่ง Tool เป็น argument ที่ 3 (ปกติส่ง nil)
local AutoDigTargetName = "Wall"       -- ชื่อบล็อกเป้าหมาย (Wall / Block / FindBlock)
local AutoDigMaxDistance = 200

local digTargets = {}
local digTargetsCollectedAt = 0
local DIG_TARGET_REFRESH = 2           -- วินาที ก่อนสแกนหาบล็อกใหม่

local AntiAFKEnabled = false
local antiAfkConnection = nil

-- หา RemoteEvent ของ Dig (เผื่อชื่อไม่ตรงเป๊ะ)
local function getDigRemote()
    local replicated = game:GetService("ReplicatedStorage")
    local remote = replicated:FindFirstChild("Dig")
    if remote and remote:IsA("RemoteEvent") then
        return remote
    end
    for _, obj in ipairs(replicated:GetDescendants()) do
        if obj:IsA("RemoteEvent") and string.find(string.lower(obj.Name), "dig") then
            return obj
        end
    end
    return nil
end

-- สแกนหาบล็อกที่ขุดได้ (จำกัดจำนวน กันหน่วง)
local function collectDigTargets()
    digTargets = {}
    local wanted = string.lower(AutoDigTargetName)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = string.lower(obj.Name)
            if name == wanted or string.find(name, "block") then
                table.insert(digTargets, obj)
                if #digTargets >= 400 then break end
            end
        end
    end
    digTargetsCollectedAt = os.clock()
end

local function getNearestDigTarget(origin)
    if os.clock() - digTargetsCollectedAt > DIG_TARGET_REFRESH then
        collectDigTargets()
    end

    local best, bestDist = nil, math.huge
    for _, part in ipairs(digTargets) do
        if part.Parent then
            local dist = (part.Position - origin).Magnitude
            if dist < bestDist and dist <= AutoDigMaxDistance then
                bestDist = dist
                best = part
            end
        end
    end
    return best
end

-- ยิง remote Dig
local function fireDig()
    local char, rootPart = getRoot()
    if not char or not rootPart then return end

    local remote = getDigRemote()
    if not remote then return end

    local origin = rootPart.Position
    local position, direction

    local target = getNearestDigTarget(origin)
    if target then
        position = target.Position
        local delta = target.Position - origin
        delta = Vector3.new(delta.X, 0, delta.Z)     -- ตัดแกน Y กันทิศทางเอียง
        -- กันเวกเตอร์ยาว 0 (ทำให้ direction เป็น NaN)
        direction = delta.Magnitude > 0.1 and delta.Unit or Vector3.new(1, 0, 0)
    else
        -- ไม่เจอบล็อก: ขุดใต้เท้าตัวเอง (fallback)
        position = origin - Vector3.new(0, 3, 0)
        direction = Vector3.new(1, 0, 0)
    end

    local thirdArg = nil
    if AutoDigSendTool then
        thirdArg = char:FindFirstChildOfClass("Tool")
    end

    pcall(function()
        remote:FireServer(position, direction, thirdArg)
    end)
end

-- Anti-AFK: กันถูกเตะตอน AFK (เกมนี้มี remote ชื่อ IdleReconnect)
local function setAntiAFK(enabled)
    AntiAFKEnabled = enabled
    if enabled then
        if not antiAfkConnection then
            antiAfkConnection = addConnection(LocalPlayer.Idled:Connect(function()
                local virtualUser = game:GetService("VirtualUser")
                pcall(function()
                    virtualUser:CaptureController()
                    virtualUser:ClickButton2(Vector2.new())
                end)
            end))
        end
    elseif antiAfkConnection then
        pcall(function() antiAfkConnection:Disconnect() end)
        antiAfkConnection = nil
    end
end

