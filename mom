-- กันรันซ้ำ: ถ้าโหลดอยู่แล้วให้ปิดของเก่าก่อน
if getgenv().CooHubLoaded and getgenv().CooHubUnload then
    pcall(getgenv().CooHubUnload)
end
getgenv().CooHubLoaded = true

-- โหลด UI Library (มี pcall กันพังทั้งสคริปต์)
local Rayfield
do
    local ok, res = pcall(function()
        return loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
    end)
    if not ok or not res then
        warn("[Coo Hub] โหลด Rayfield ไม่สำเร็จ: " .. tostring(res))
        getgenv().CooHubLoaded = false
        return
    end
    Rayfield = res
end

-- เก็บ connection ทั้งหมดไว้ที่เดียว เพื่อ unload ได้สะอาด
local connections = {}
local function addConnection(conn)
    table.insert(connections, conn)
    return conn
end

-- ============================================================
--  ระบบบิน
-- ============================================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local LocalPlayer = Players.LocalPlayer
local flyEnabled = false
local flySpeed = 60
local flyVelocity
local flyGyro
local flyHumanoid
local flyRoot
local flyUpHeld = false
local flyDownHeld = false
local flyControlsBound = false

local function handleFlyUp(_, inputState)
    flyUpHeld = inputState == Enum.UserInputState.Begin
    return Enum.ContextActionResult.Sink
end

local function handleFlyDown(_, inputState)
    flyDownHeld = inputState == Enum.UserInputState.Begin
    return Enum.ContextActionResult.Sink
end

local function bindFlyControls()
    if flyControlsBound then
        return
    end

    flyControlsBound = true
    ContextActionService:BindAction(
        "CooHubFlyUp",
        handleFlyUp,
        UserInputService.TouchEnabled,
        Enum.KeyCode.Space
    )
    ContextActionService:BindAction(
        "CooHubFlyDown",
        handleFlyDown,
        UserInputService.TouchEnabled,
        Enum.KeyCode.LeftControl
    )

    if UserInputService.TouchEnabled then
        ContextActionService:SetTitle("CooHubFlyUp", "ขึ้น")
        ContextActionService:SetTitle("CooHubFlyDown", "ลง")
        ContextActionService:SetPosition("CooHubFlyUp", UDim2.new(1, -155, 1, -265))
        ContextActionService:SetPosition("CooHubFlyDown", UDim2.new(1, -80, 1, -340))
    end
end

local function unbindFlyControls()
    ContextActionService:UnbindAction("CooHubFlyUp")
    ContextActionService:UnbindAction("CooHubFlyDown")
    flyControlsBound = false
    flyUpHeld = false
    flyDownHeld = false
end

local function stopFly()
    flyEnabled = false
    unbindFlyControls()

    if flyVelocity then
        flyVelocity:Destroy()
        flyVelocity = nil
    end

    if flyGyro then
        flyGyro:Destroy()
        flyGyro = nil
    end

    if flyHumanoid and flyHumanoid.Parent then
        flyHumanoid.PlatformStand = false
        flyHumanoid.AutoRotate = true
    end

    if flyRoot and flyRoot.Parent then
        flyRoot.AssemblyLinearVelocity = Vector3.zero
        flyRoot.AssemblyAngularVelocity = Vector3.zero
    end

    flyHumanoid = nil
    flyRoot = nil
end

local function startFly()
    stopFly()

    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or humanoid.Health <= 0 then
        warn("[Coo Hub] ไม่พบตัวละครสำหรับเริ่มบิน")
        return false
    end

    flyHumanoid = humanoid
    flyRoot = root
    flyEnabled = true

    humanoid.PlatformStand = true
    humanoid.AutoRotate = false

    flyVelocity = Instance.new("BodyVelocity")
    flyVelocity.Name = "CooHubFlyVelocity"
    flyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    flyVelocity.P = 12500
    flyVelocity.Velocity = Vector3.zero
    flyVelocity.Parent = root

    flyGyro = Instance.new("BodyGyro")
    flyGyro.Name = "CooHubFlyGyro"
    flyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    flyGyro.P = 12500
    flyGyro.D = 500
    flyGyro.CFrame = root.CFrame
    flyGyro.Parent = root

    bindFlyControls()

    return true
end

addConnection(RunService.RenderStepped:Connect(function()
    if not flyEnabled then
        return
    end

    if not flyRoot or not flyRoot.Parent or not flyHumanoid or flyHumanoid.Health <= 0 then
        stopFly()
        return
    end

    local camera = workspace.CurrentCamera
    if not camera or not flyVelocity or not flyGyro then
        return
    end

    local input = Vector3.zero
    if UserInputService.TouchEnabled then
        -- จอยเดินมาตรฐานของ Roblox ส่งทิศทางมาใน MoveDirection อยู่แล้ว
        local moveDirection = flyHumanoid.MoveDirection
        input += Vector3.new(moveDirection.X, 0, moveDirection.Z)
    else
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then input += camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then input -= camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then input += camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then input -= camera.CFrame.RightVector end
    end

    if flyUpHeld then input += Vector3.yAxis end
    if flyDownHeld then input -= Vector3.yAxis end

    flyHumanoid.PlatformStand = true
    flyVelocity.Velocity = input.Magnitude > 0 and input.Unit * flySpeed or Vector3.zero
    flyGyro.CFrame = CFrame.lookAt(flyRoot.Position, flyRoot.Position + camera.CFrame.LookVector)
end))

addConnection(LocalPlayer.CharacterAdded:Connect(function()
    stopFly()
end))

