-- แปลงข้อความ "a, b, c" เป็นตารางคำค้น
local function parseKeywords(text)
    local list = {}
    for word in string.gmatch(text or "", "[^,]+") do
        local trimmed = string.lower(word)
        trimmed = trimmed:match("^%s*(.-)%s*$")
        if trimmed and trimmed ~= "" then
            table.insert(list, trimmed)
        end
    end
    return list
end

-- หา RootPart ของตัวละครตัวเอง
local function getMyRoot()
    local character = LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

-- ข้ามตัวละครผู้เล่น (ไม่อยากให้ ESP ไปติดกรอบใส่กันเอง)
local function isPlayerCharacter(instance)
    local model = instance:IsA("Model") and instance or instance:FindFirstAncestorOfClass("Model")
    if model and Players:GetPlayerFromCharacter(model) then
        return true
    end

    local node = instance.Parent
    for _ = 1, 6 do
        if not node or node == workspace then break end
        if node.Name == "Characters" then return true end
        node = node.Parent
    end
    return false
end

-- ============================================================
--  1) Module Dump  — ดึงข้อมูลจริงจากโมดูลของเกม
--  วิธีใช้: กดปุ่ม แล้วอ่านผลใน Console (F9)
--  ประโยชน์: ได้ชื่อ RemoteEvent / ตาราง config จริง
--            ทำให้ระบบอื่นแม่นขึ้นโดยไม่ต้องเดา
-- ============================================================
local DUMP_MODULES = {
    "Digging", "Dirt", "Eggs", "GrowingEggs", "EggEvents",
    "Artifacts", "Market", "Pets", "PetIndex", "Animals",
    "Progression", "TrainingUpgrades", "Offline", "Admin",
}

local function logLine(text)
    print("[Coo Hub] " .. text)
end

-- แสดงค่าในตารางแบบอ่านง่าย (Instance จะโชว์ Path ให้เลย)
local function describeTable(source, prefix)
    local count = 0
    for key, value in pairs(source) do
        local kind = typeof(value)
        if kind == "Instance" then
            logLine(string.format("%s%s (%s) -> %s", prefix, tostring(key), kind, value:GetFullName()))
        elseif kind == "function" then
            logLine(string.format("%s%s (function)", prefix, tostring(key)))
        elseif kind == "table" then
            logLine(string.format("%s%s (table, %d ค่า)", prefix, tostring(key), #value))
        else
            logLine(string.format("%s%s (%s) = %s", prefix, tostring(key), kind, tostring(value)))
        end

        count += 1
        if count >= 80 then break end
    end
    return count
end

-- ดึงชื่อ Remote ทั้งหมดใน ReplicatedStorage
local function dumpRemotes()
    logLine("---- Remote ใน ReplicatedStorage ----")
    local total = 0
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")
            or obj:IsA("UnreliableRemoteEvent") then
            logLine(string.format("   %s  [%s]", obj:GetFullName(), obj.ClassName))
            total += 1
            if total >= 150 then break end
        end
    end
    logLine("รวม Remote: " .. tostring(total) .. " รายการ")
    return total
end

-- โหลดโมดูลเกมและปริ้นค่าข้างใน
local function dumpModules()
    logLine("========== MODULE DUMP ==========")
    logLine("ผู้เล่น: " .. LocalPlayer.Name)
    logLine("เกม: " .. tostring(game.PlaceId))

    local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
    if not playerScripts then
        warn("[Coo Hub] หา PlayerScripts ไม่เจอ")
        return
    end

    local loaded, failed = 0, 0
    for _, moduleName in ipairs(DUMP_MODULES) do
        local moduleScript = playerScripts:FindFirstChild(moduleName)
        if moduleScript and moduleScript:IsA("ModuleScript") then
            local ok, result = pcall(require, moduleScript)
            if ok and type(result) == "table" then
                logLine(string.format("--- %s (โหลดสำเร็จ) ---", moduleName))
                describeTable(result, "    ")
                loaded += 1
            else
                logLine(string.format("--- %s (require ไม่ได้: %s) ---", moduleName, tostring(result)))
                failed += 1
            end
        else
            logLine("--- " .. moduleName .. " (ไม่พบโมดูล) ---")
            failed += 1
        end
    end

    logLine(string.format("สรุป: สำเร็จ %d | ไม่ได้ %d", loaded, failed))
    dumpRemotes()
    logLine("=================================")
end

-- ============================================================
--  2) Auto Dig  — ขุดอัตโนมัติ
--  อ้างอิง remote จริงที่ดักได้จาก Cobalt:
--    ReplicatedStorage.Dig:FireServer(Vector3 ตำแหน่ง, Vector3 ทิศทาง, nil)
-- ============================================================
local Dig = {
    Enabled      = false,
    Delay        = 0.2,
    MaxDistance  = 200,
    Keyword      = "Wall,Block,Ore,Dirt,Dig,FindBlock",
    SendTool     = false,
    LastFire     = 0,
}

local digRemote = nil
local digTargets = {}
local digTargetsAt = 0
local DIG_RESCAN = 2          -- วินาที ก่อนสแกนหาบล็อกใหม่
local DIG_MAX_TARGETS = 400
local SCAN_ITERATION_CAP = 20000   -- เพดานการวน objects กันแมพใหญ่ทำเฟรมตก

local function getDigRemote()
    if digRemote and digRemote.Parent then return digRemote end

    local direct = ReplicatedStorage:FindFirstChild("Dig")
    if direct and direct:IsA("RemoteEvent") then
        digRemote = direct
        return digRemote
    end

    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") and string.find(string.lower(obj.Name), "dig", 1, true) then
            digRemote = obj
            return digRemote
        end
    end
    return nil
end

local function collectDigTargets()
    digTargets = {}
    local keywords = parseKeywords(Dig.Keyword)
    local visited = 0

    for _, obj in ipairs(workspace:GetDescendants()) do
        visited += 1
        if visited > SCAN_ITERATION_CAP then break end

        if obj:IsA("BasePart") and not isPlayerCharacter(obj) then
            local lower = string.lower(obj.Name)
            for _, keyword in ipairs(keywords) do
                if string.find(lower, keyword, 1, true) then
                    table.insert(digTargets, obj)
                    break
                end
            end
            if #digTargets >= DIG_MAX_TARGETS then break end
        end
    end

    digTargetsAt = os.clock()
end

local function getNearestDigTarget(origin)
    if os.clock() - digTargetsAt > DIG_RESCAN then
        collectDigTargets()
    end

    local best, bestDistance = nil, math.huge
    for _, part in ipairs(digTargets) do
        if part.Parent then
            local distance = (part.Position - origin).Magnitude
            if distance < bestDistance and distance <= Dig.MaxDistance then
                bestDistance, best = distance, part
            end
        end
    end
    return best
end

local function fireDigAt(position, direction)
    local remote = getDigRemote()
    if not remote then return false end

    local thirdArg = nil
    if Dig.SendTool then
        local character = LocalPlayer.Character
        thirdArg = character and character:FindFirstChildOfClass("Tool") or nil
    end

    local ok = pcall(function()
        remote:FireServer(position, direction, thirdArg)
    end)
    return ok
end

local function autoDigStep()
    local root = getMyRoot()
    if not root then return end

    local origin = root.Position
    local target = getNearestDigTarget(origin)

    local position, direction
    if target then
        position = target.Position
        local delta = target.Position - origin
        delta = Vector3.new(delta.X, 0, delta.Z)      -- ตัดแกน Y กันทิศทางเอียง
        -- กันเวกเตอร์ยาว 0 (ทำให้ direction กลายเป็น NaN)
        direction = delta.Magnitude > 0.1 and delta.Unit or Vector3.xAxis
    else
        -- ไม่เจอบล็อก: ขุดใต้เท้าตัวเอง
        position = origin - Vector3.new(0, 3, 0)
        direction = Vector3.xAxis
    end

    fireDigAt(position, direction)
end

-- ============================================================
--  3) Auto เก็บของ  — เก็บไข่/ของที่ขุดเจอ
--  อ้างอิง remote ที่ดักได้: ArtifactPickup, DirtEarned
--  ถ้าเกมไม่มี remote ให้เปิด "เดินไปเก็บ" แทน
-- ============================================================
local Collect = {
    Enabled      = false,
    Delay        = 0.15,
    MaxDistance  = 40,
    Keyword      = "Artifact,Egg,Dirt,Coin,Relic",
    CallStyle    = "ตำแหน่ง + ชื่อ",
    WalkTo       = false,
    LastRun      = 0,
}

local collectRemote = nil
local collectTargets = {}
local collectTargetsAt = 0
local collectCooldown = {}    -- [part] = เวลาที่เพิ่งเก็บไป
local COLLECT_RESCAN = 1.5
local COLLECT_MAX_TARGETS = 200
local COLLECT_COOLDOWN = 4    -- กันยิงซ้ำชิ้นเดิมรัว ๆ

local function getCollectRemote()
    if collectRemote and collectRemote.Parent then return collectRemote end

    local directNames = { "ArtifactPickup", "Pickup", "CollectDirt", "CollectItem" }
    for _, name in ipairs(directNames) do
        local found = ReplicatedStorage:FindFirstChild(name)
        if found and found:IsA("RemoteEvent") then
            collectRemote = found
            return collectRemote
        end
    end

    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local lower = string.lower(obj.Name)
            if string.find(lower, "artifact", 1, true)
                or string.find(lower, "pickup", 1, true)
                or string.find(lower, "collect", 1, true) then
                collectRemote = obj
                return collectRemote
            end
        end
    end
    return nil
end

local function fireCollect(part)
    local remote = getCollectRemote()
    if not remote then return false end

    local style = Collect.CallStyle
    local ok = pcall(function()
        if style == "ตำแหน่ง" then
            remote:FireServer(part.Position)
        elseif style == "ชื่อ" then
            remote:FireServer(part.Name)
        elseif style == "ชิ้นส่วน" then
            remote:FireServer(part)
        else
            remote:FireServer(part.Position, part.Name)
        end
    end)
    return ok
end

local function collectItems()
    collectTargets = {}
    local keywords = parseKeywords(Collect.Keyword)
    local root = getMyRoot()
    if not root then return end

    local visited = 0
    for _, obj in ipairs(workspace:GetDescendants()) do
        visited += 1
        if visited > SCAN_ITERATION_CAP then break end

        if obj:IsA("BasePart") and not isPlayerCharacter(obj) then
            local lower = string.lower(obj.Name)
            for _, keyword in ipairs(keywords) do
                if string.find(lower, keyword, 1, true) then
                    local distance = (obj.Position - root.Position).Magnitude
                    if distance <= Collect.MaxDistance then
                        table.insert(collectTargets, obj)
                    end
                    break
                end
            end
            if #collectTargets >= COLLECT_MAX_TARGETS then break end
        end
    end

    collectTargetsAt = os.clock()
end

local function autoCollectStep()
    local root = getMyRoot()
    if not root then return end

    if os.clock() - collectTargetsAt > COLLECT_RESCAN then
        collectItems()
    end

    -- เคลียร์รายการที่ถูกเก็บไปแล้ว
    local now = os.clock()
    for part in pairs(collectCooldown) do
        if not part.Parent or now - collectCooldown[part] > COLLECT_COOLDOWN then
            collectCooldown[part] = nil
        end
    end

    local best, bestDistance = nil, math.huge
    for _, part in ipairs(collectTargets) do
        if part.Parent and not collectCooldown[part] then
            local distance = (part.Position - root.Position).Magnitude
            if distance < bestDistance then
                bestDistance, best = distance, part
            end
        end
    end

    if not best then return end
    collectCooldown[best] = now

    if Collect.WalkTo then
        local humanoid = LocalPlayer.Character
            and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            pcall(function() humanoid:MoveTo(best.Position) end)
        end
    else
        fireCollect(best)
    end
end

-- ============================================================
--  4) ESP ไข่ / ของหายาก  — สแกนตามชื่อ (ไม่ต้องใช้ Tag)
--  ต่างจาก "ตัวค้นหาแอดมิน" ตรงที่ใช้ได้กับผู้เล่นทั่วไป
--  เพราะค้นหาจากชื่อชิ้นส่วนใน Workspace แทน Tag
-- ============================================================
local RareFinder = {
    Enabled      = false,
    Keyword      = "Egg,Artifact,Ore,Gem,Crystal,Relic",
    MaxDistance  = 0,                     -- 0 = ไม่จำกัด
    Refresh      = 1,
    Color        = Color3.fromRGB(255, 130, 255),
    LastScan     = 0,
}

local rareMarkers = {}
local RARE_MAX_TARGETS = 250

local function removeRareMarker(instance)
    local marker = rareMarkers[instance]
    if not marker then return end
    if marker.highlight then pcall(function() marker.highlight:Destroy() end) end
    if marker.billboard then pcall(function() marker.billboard:Destroy() end) end
    rareMarkers[instance] = nil
end

local function clearRareMarkers()
    for instance in pairs(rareMarkers) do
        removeRareMarker(instance)
    end
end

local function addRareMarker(instance)
    if rareMarkers[instance] or not instance:IsDescendantOf(workspace) then return end

    local part = getFinderPart(instance)
    if not part then return end

    local color = RareFinder.Color

    local highlight = Instance.new("Highlight")
    highlight.Name = "CooHubRareHighlight"
    highlight.Adornee = (instance:IsA("Model") or instance:IsA("BasePart")) and instance or part
    highlight.FillColor = color
    highlight.FillTransparency = 0.6
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = instance

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "CooHubRareLabel"
    billboard.Adornee = part
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 3000
    billboard.Size = UDim2.fromOffset(200, 40)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
    billboard.Parent = LocalPlayer:WaitForChild("PlayerGui")

    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
    label.BackgroundTransparency = 0.2
    label.BorderSizePixel = 0
    label.Size = UDim2.fromScale(1, 1)
    label.Font = Enum.Font.GothamBold
    label.TextColor3 = color
    label.TextScaled = true
    label.TextStrokeTransparency = 0.45
    label.Parent = billboard

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = label

    rareMarkers[instance] = {
        highlight = highlight,
        billboard = billboard,
        label = label,
        part = part,
    }
end

local function refreshRareMarkers(force)
    if not RareFinder.Enabled and not force then return end

    local keywords = parseKeywords(RareFinder.Keyword)
    local foundNow = {}
    local count = 0
    local visited = 0

    for _, obj in ipairs(workspace:GetDescendants()) do
        visited += 1
        if visited > SCAN_ITERATION_CAP then break end

        if obj:IsA("BasePart") and not isPlayerCharacter(obj) then
            local lower = string.lower(obj.Name)
            for _, keyword in ipairs(keywords) do
                if string.find(lower, keyword, 1, true) then
                    foundNow[obj] = true
                    addRareMarker(obj)
                    count += 1
                    break
                end
            end
            if count >= RARE_MAX_TARGETS then break end
        end
    end

    for instance in pairs(rareMarkers) do
        if not foundNow[instance] or not instance.Parent then
            removeRareMarker(instance)
        end
    end

    RareFinder.LastScan = os.clock()
end

local function updateRareDistances()
    local root = getMyRoot()
    if not root then return end

    for instance, marker in pairs(rareMarkers) do
        if not instance.Parent or not marker.part or not marker.part.Parent then
            removeRareMarker(instance)
        else
            local distance = (root.Position - marker.part.Position).Magnitude

            if RareFinder.MaxDistance > 0 and distance > RareFinder.MaxDistance then
                marker.highlight.Enabled = false
                marker.billboard.Enabled = false
            else
                marker.highlight.Enabled = true
                marker.billboard.Enabled = true
                marker.label.Text = string.format("%s  •  %.0f เมตร", instance.Name, distance)
            end
        end
    end
end

-- ============================================================
--  Heartbeat รวมของระบบขุด/เก็บ/ESP
-- ============================================================
local farmElapsed = 0
addConnection(RunService.Heartbeat:Connect(function(deltaTime)
    local now = os.clock()

    -- Auto Dig
    if Dig.Enabled and now - Dig.LastFire >= Dig.Delay then
        Dig.LastFire = now
        autoDigStep()
    end

    -- Auto เก็บของ
    if Collect.Enabled and now - Collect.LastRun >= Collect.Delay then
        Collect.LastRun = now
        autoCollectStep()
    end

    -- ESP ของหายาก (สแกนไม่ถี่เกินไป กันเกมหน่วง)
    farmElapsed += deltaTime
    if RareFinder.Enabled and farmElapsed >= 0.35 then
        farmElapsed = 0
        if now - RareFinder.LastScan > RareFinder.Refresh then
            refreshRareMarkers()
        end
        updateRareDistances()
    end
end))

