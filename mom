-- สร้างปุ่ม AIM บนจอ (กดค้าง = เล็ง / ลาก = ย้ายปุ่ม)
local function createMobileButton()
    if Mobile.Gui then return true end

    local gui = Instance.new("ScreenGui")
    gui.Name = "CooHubMobile"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Enabled = Mobile.ShowButton

    local button = Instance.new("TextButton")
    button.Name = "AimButton"
    button.Size = UDim2.new(0, Mobile.ButtonSize, 0, Mobile.ButtonSize)
    button.Position = UDim2.fromScale(Mobile.X, Mobile.Y)
    button.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    button.BackgroundTransparency = 0.25
    button.Text = "AIM"
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextScaled = true
    button.Font = Enum.Font.GothamBold
    button.Active = true
    button.AutoButtonColor = false
    button.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = button

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 80, 80)
    stroke.Thickness = 2
    stroke.Parent = button

    -- กดค้าง = เล็ง | ลากเกิน 12px = ย้ายปุ่ม (กันนิ้วสั่นเล็กน้อย)
    local dragging, dragStart, startPos = false, nil, nil
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = button.Position
            setMobileButtonHeld(true)
        end
    end)
    button.InputChanged:Connect(function(input)
        if not dragging or not dragStart then return end
        if input.UserInputType ~= Enum.UserInputType.Touch
            and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end

        local delta = input.Position - dragStart
        local moved = math.abs(delta.X) + math.abs(delta.Y)

        if moved > 12 then
            -- ลากจัดว่าเป็นการย้ายปุ่ม ไม่ใช่การเล็ง
            setMobileButtonHeld(false)
            button.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            Mobile.X = button.Position.X.Scale
            Mobile.Y = button.Position.Y.Scale
        end
    end)
    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            dragStart = nil
            setMobileButtonHeld(false)
        end
    end)

    -- parent ลง PlayerGui แบบปลอดภัย (CoreGui มักไม่ให้สิทธิ์)
    local ok = pcall(function() gui.Parent = LocalPlayer:WaitForChild("PlayerGui", 10) end)
    if not ok or not gui.Parent then
        warn("[Coo Hub] สร้างปุ่ม AIM บนจอไม่สำเร็จ")
        gui:Destroy()
        return false
    end

    Mobile.Gui = gui
    Mobile.Button = button
    return true
end

local function setMobileMode(enabled)
    Mobile.Enabled = enabled
