-- ============================================================
--  ระบบ Unload: ปลด connection + ปิด UI ให้สะอาด
-- ============================================================
getgenv().CooHubUnload = function()
    stopFly()

    -- หยุดระบบขุด/เก็บ/ESP ของหายาก
    Dig.Enabled = false
    Collect.Enabled = false
    RareFinder.Enabled = false
    table.clear(digTargets)
    table.clear(collectTargets)
    table.clear(collectCooldown)
    clearRareMarkers()

    finderStates.GoodItem = false
    finderStates.GoodEgg = false
    clearFinderMarkers("GoodItem")
    clearFinderMarkers("GoodEgg")

    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(connections)

    pcall(function() Rayfield:Destroy() end)

    getgenv().CooHubLoaded = false
    getgenv().CooHubUnload = nil
    print("[Coo Hub] Unloaded")
end
